---
import ArtPlums from "@/components/ArtPlums.astro";
import { getTranslations } from "@/i18n";
import { buildLayoutMetadata } from "@/lib/layout";
import type { Locale, Profile } from "@/types";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import "../globals.css";

interface Props {
  personName: string;
  jobTitle: string;
  locale: Locale;
  image: string;
  summary: string[];
  profiles: Profile[];
  theme: string;
}

const { personName, jobTitle, locale, image, summary, profiles, theme } =
  Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const currentPath = locale === "es" ? "/es/" : "/";
const url = new URL(currentPath, siteUrl).toString();
const alternateUrls = {
  en: new URL("/", siteUrl).toString(),
  es: new URL("/es/", siteUrl).toString(),
};
const title = `${personName} — ${jobTitle}`;
const t = getTranslations(locale);
const {
  absoluteImage,
  plainSummary,
  twitterDomain,
  ogLocale,
  alternateOgLocale,
  personSchema,
} = buildLayoutMetadata({
  personName,
  jobTitle,
  lang: locale,
  image,
  summary,
  url,
  siteUrl: siteUrl.toString(),
  profiles,
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={plainSummary} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={url} />
    <link rel="alternate" href={alternateUrls.en} hreflang="en" />
    <link rel="alternate" href={alternateUrls.es} hreflang="es" />
    <link rel="alternate" href={alternateUrls.en} hreflang="x-default" />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={personName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={plainSummary} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={personName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={twitterDomain} />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={plainSummary} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={personName} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const storedMode = localStorage.getItem("theme");
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        root.classList.toggle(
          "dark",
          storedMode === "dark" || (storedMode === null && prefersDark),
        );
      })();
    </script>
  </head>
  <body
    data-theme={theme}
    class="bg-skin-fill text-skin-base relative font-sans"
  >
    <script is:inline>
      (() => {
        const storedColor = localStorage.getItem("data-theme");
        const allowed = [
          "red",
          "blue",
          "yellow",
          "purple",
          "green",
          "orange",
          "pink",
          "aqua",
          "sepia",
          "blackwhite",
        ];
        if (storedColor && allowed.includes(storedColor)) {
          document.body.dataset.theme = storedColor;
        }
      })();
    </script>
    <ArtPlums />
    <a href="#main-content" class="skip-link">
      {t.skipLink}
    </a>
    <main
      id="main-content"
      tabindex="-1"
      class="grid min-h-dvh grid-cols-1 grid-rows-[1fr_auto_auto_auto_auto]"
    >
      <slot />
    </main>

    <style>
      @reference "../globals.css";

      html {
        scroll-behavior: smooth;
      }
      body,
      figure {
        margin: 0;
        padding: 0;
      }

      a {
        text-decoration: none;
      }

      :focus-visible {
        outline: 3px solid rgb(var(--color));
        outline-offset: 3px;
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .skip-link {
        position: absolute;
        left: 1rem;
        top: 1rem;
        z-index: 50;
        transform: translateY(-200%);
        border: 1px solid rgb(var(--color));
        border-radius: 0.375rem;
        background: rgb(var(--color-fill));
        color: rgb(var(--color-text-base));
        padding: 0.5rem 0.75rem;
        transition: transform 0.2s ease;
      }

      .skip-link:focus {
        transform: translateY(0);
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      h1,
      h2,
      h3,
      h4 {
        @apply text-skin-base font-sans;
        margin: 0;
      }

      p {
        @apply text-skin-muted text-sm;
        line-height: 1.5;
        text-wrap: pretty;
      }

      .print {
        display: none !important;
      }

      .dev * {
        @apply border border-red-500/50 bg-red-500/5;
      }

      ::-webkit-scrollbar {
        width: 2px;
      }

      @media print {
        .print {
          display: block !important;
        }

        astro-dev-toolbar {
          display: none !important;
        }

        article {
          break-inside: avoid;
        }

        canvas,
        button,
        select,
        nav,
        #normal-footer {
          display: none !important;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </body>
</html>
