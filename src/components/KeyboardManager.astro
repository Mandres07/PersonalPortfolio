---
import "hotkeypad/index.css";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@/i18n";
import type { Locale, Profile } from "@/types";

interface Props {
  profiles: Profile[];
  locale: Locale;
}

const { locale, profiles } = Astro.props;
const t = getTranslations(locale);
---

<div
  id="normal-footer"
  class="theme-blackwhite:text-skin-inverted flex flex-col gap-2 font-mono"
>
  <p>
    {t.actions.paletteLead}{" "}
    <kbd>Ctrl</kbd>/<kbd>Command</kbd> + <kbd>K</kbd>
    {" "}{t.actions.paletteTrail}
  </p>
</div>
<button
  type="button"
  disabled
  data-command-palette-trigger
  class="footer-button border-skin-muted/60 bg-skin-fill text-skin-button-accent theme-blackwhite:border-skin-muted z-20 border transition-colors duration-200 ease-linear"
  aria-label={t.actions.openPalette}
>
  <Icon
    name="ri:command-fill"
    width={20}
    height={20}
    class="text-skin-button-accent theme-blackwhite:dark:text-skin-inverted"
    aria-hidden="true"
  />
</button>

<div
  id="hotkeypad"
  data-placeholder={t.actions.search}
  data-profiles={JSON.stringify(profiles)}
  data-locale={locale}
>
</div>

<script>
  import {
    buildProfilesInfo,
    createKeyboardCommands,
  } from "@/lib/keyboard-manager";
  import type { Locale, Profile } from "@/types";
  import HotKeyPad from "hotkeypad";

  const hotkeypad = new HotKeyPad();
  const activationKey = hotkeypad.activationKey === "Cmd" ? "Cmd" : "Ctrl";
  const profiles = JSON.parse(
    hotkeypad.instance.getAttribute("data-profiles") ?? "[]",
  ) as Profile[];
  const locale = (hotkeypad.instance.getAttribute("data-locale") ??
    "en") as Locale;
  const info = buildProfilesInfo(profiles, locale, activationKey);
  const abortController = new AbortController();
  const { signal } = abortController;
  let returnFocus: HTMLElement | null = null;

  hotkeypad.setCommands(
    createKeyboardCommands(
      info,
      locale,
      (url, target) => {
        const opened = window.open(url, target, "noopener,noreferrer");
        if (opened) opened.opener = null;
      },
      activationKey,
    ),
  );

  document.addEventListener(
    "click",
    (event) => {
      const button = (
        event.target as Element | null
      )?.closest<HTMLButtonElement>("[data-command-palette-trigger]");
      if (!button) return;
      returnFocus = button;
      hotkeypad.open();
    },
    { signal },
  );

  document
    .querySelectorAll<HTMLButtonElement>("[data-command-palette-trigger]")
    .forEach((button) => {
      button.disabled = false;
    });

  hotkeypad.instance.dataset.ready = "true";

  window.addEventListener(
    "hotkeypad:open",
    () => {
      returnFocus ??= document.activeElement as HTMLElement | null;
      const backdrop =
        hotkeypad.instance.querySelector<HTMLElement>("[data-backdrop]");
      if (backdrop) backdrop.style.opacity = "0.8";
    },
    { signal },
  );

  window.addEventListener(
    "hotkeypad:close",
    () => {
      const backdrop =
        hotkeypad.instance.querySelector<HTMLElement>("[data-backdrop]");
      if (backdrop) backdrop.style.opacity = "0";
      returnFocus?.focus();
      returnFocus = null;
    },
    { signal },
  );

  window.addEventListener("pagehide", () => abortController.abort(), {
    once: true,
  });
</script>

<style>
  @reference "../globals.css";

  @media (min-width: 601px) {
    .footer-button {
      display: none;
    }
  }

  @media (max-width: 600px) {
    #normal-footer {
      display: none;
    }

    .footer-button {
      appearance: none;
      border-radius: 50%;
      bottom: 10px;
      display: flex;
      align-items: center;
      cursor: pointer;
      height: 50px;
      justify-content: center;
      padding: 0;
      position: fixed;
      right: 10px;
      width: 50px;
    }
  }

  #normal-footer {
    @apply bg-skin-button-accent;
    position: fixed;
    bottom: 0;
    width: 100%;
    padding-block: 8px;
    text-align: center;
    font-size: 0.85rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  #normal-footer p {
    color: rgb(var(--color-accent-foreground));
    margin: 0;
  }

  #normal-footer kbd {
    background: rgb(var(--muted));
    border-radius: 4px;
    color: rgb(var(--color-text-base));
    font-size: 12px;
    padding: 2px 4px;
  }

  #hotkeypad {
    --hotkeypad-bg-kbd: rgb(var(--muted));
    --hotkeypad-bg-backdrop: rgb(var(--muted));
    --hotkeypad-bg-container: rgb(var(--color-fill));
    --hotkeypad-bg-item-hover: rgba(var(--color), 10%);
    --hotkeypad-border-container: rgb(var(--muted));
    --hotkeypad-border-container-hover: rgb(var(--color-fill));
    --hotkeypad-fg-muted: rgb(var(--color-text-base));
  }
</style>
