---
import { Icon } from "astro-icon/components";
import { getTranslations } from "@/i18n";
import { COLOR_THEMES, type ColorTheme } from "@/lib/theme-switch";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
  defaultTheme: string;
}

const { locale, defaultTheme } = Astro.props;
const t = getTranslations(locale);
const selectedTheme = COLOR_THEMES.includes(defaultTheme as ColorTheme)
  ? (defaultTheme as ColorTheme)
  : "green";
---

<div class="inline-flex items-center">
  <div
    class="group/theme flex cursor-pointer items-center gap-2 rounded-md bg-transparent"
  >
    <button
      type="button"
      id="themeSwitch"
      class="cursor-pointer"
      data-switch-dark={t.theme.switchToDark}
      data-switch-light={t.theme.switchToLight}
      aria-label={t.theme.switchToDark}
      aria-pressed="false"
    >
      <span
        class="text-skin-base flex items-center gap-1 text-sm leading-6 font-medium transition-transform ease-in-out group-hover/theme:rotate-45"
      >
        <Icon
          name="ri:moon-fill"
          class="hidden dark:block"
          width={20}
          height={20}
          aria-hidden="true"
        />
        <Icon
          name="ri:sun-fill"
          class="dark:hidden"
          width={20}
          height={20}
          aria-hidden="true"
        />
      </span>
    </button>

    <label class="sr-only" for="themeSelect">{t.theme.color}</label>
    <div class="relative flex">
      <select
        id="themeSelect"
        class="text-skin-base ring-skin-muted focus:ring-skin-hue block w-full appearance-none rounded-md border-0 bg-transparent py-1.5 pr-10 pl-3 font-mono ring-1 ring-inset focus:ring-2 focus-visible:outline-none sm:text-sm sm:leading-6"
      >
        {
          COLOR_THEMES.map((theme) => (
            <option value={theme} selected={theme === selectedTheme}>
              {t.theme.names[theme]}
            </option>
          ))
        }
      </select>
      <Icon
        name="ri:arrow-down-s-line"
        class="text-skin-base pointer-events-none absolute top-1/2 right-3 -translate-y-1/2"
        width={16}
        height={16}
        aria-hidden="true"
      />
    </div>

    <label class="sr-only" for="languageSelect">{t.theme.language}</label>
    <div class="relative flex">
      <select
        id="languageSelect"
        class="text-skin-base ring-skin-muted focus:ring-skin-hue block appearance-none rounded-md border-0 bg-transparent py-1.5 pr-10 pl-3 font-mono ring-1 ring-inset focus:ring-2 focus-visible:outline-none sm:text-sm sm:leading-6"
      >
        <option value="en" selected={locale === "en"}
          >🇺🇸 {t.theme.languages.en}</option
        >
        <option value="es" selected={locale === "es"}
          >🇪🇸 {t.theme.languages.es}</option
        >
      </select>
      <Icon
        name="ri:arrow-down-s-line"
        class="text-skin-base pointer-events-none absolute top-1/2 right-3 -translate-y-1/2"
        width={16}
        height={16}
        aria-hidden="true"
      />
    </div>
  </div>
</div>

<script>
  import { initializeThemeSwitch } from "@/lib/theme-switch";

  initializeThemeSwitch({ document, window });
</script>

<style>
  :global(.dark) {
    color-scheme: dark;
  }
</style>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-old(root) {
    z-index: 1;
  }
  ::view-transition-new(root) {
    z-index: 9999;
  }
  .dark::view-transition-old(root) {
    z-index: 9999;
  }
  .dark::view-transition-new(root) {
    z-index: 1;
  }
</style>
