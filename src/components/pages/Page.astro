---
import Layout from "@/layouts/Layout.astro";
import About from "@/components/sections/About.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import Footer from "@/components/sections/Footer.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import Education from "@/components/sections/Education.astro";
import Images from "@/components/sections/Images.astro";
import Navigation from "@/components/sections/Navigation.astro";
import { type CV, type Locale, type SectionId } from "@/types";

interface Props {
  CV: CV;
  locale: Locale;
}

const { CV, locale } = Astro.props;
const basics = CV.basics;
const availableSections: SectionId[] = [
  ...(CV.work.length ? (["experience"] as const) : []),
  ...(CV.projects.length ? (["work"] as const) : []),
  ...(CV.education.length || CV.certificates.length
    ? (["education"] as const)
    : []),
  ...(CV.images.list.length ? (["images"] as const) : []),
  ...(CV.skills.length ? (["skills"] as const) : []),
];
---

<Layout
  personName={basics.name}
  jobTitle={basics.label}
  locale={locale}
  image={basics.image}
  summary={basics.summary}
  profiles={basics.profiles}
  theme={basics.theme}
>
  <div
    class="relative container grid max-w-7xl grid-cols-1 gap-4 p-8 md:gap-12 md:p-16 md:pb-10 lg:grid-cols-5 xl:gap-24"
  >
    <aside
      class="slide-enter space-y-10 ease-in lg:sticky lg:top-16 lg:col-span-2 lg:self-start"
    >
      <Hero basics={basics} locale={locale} />
      <About summary={basics.summary} locale={locale} />
      <ThemeSwitch locale={locale} defaultTheme={basics.theme} />
    </aside>
    <div class="slide-enter-content space-y-6 lg:col-span-3">
      <Navigation locale={locale} sections={availableSections} />
      {CV.work.length > 0 && <Experience locale={locale} work={CV.work} />}
      {
        CV.projects.length > 0 && (
          <Projects locale={locale} projects={CV.projects} />
        )
      }
      {
        (CV.education.length > 0 || CV.certificates.length > 0) && (
          <Education
            locale={locale}
            certificates={CV.certificates}
            education={CV.education}
          />
        )
      }
      {
        CV.images.list.length > 0 && (
          <Images locale={locale} images={CV.images} />
        )
      }
      {CV.skills.length > 0 && <Skills locale={locale} skills={CV.skills} />}
    </div>
  </div>
  <Footer locale={locale} />
  <KeyboardManager locale={locale} profiles={basics.profiles} />
  <script>
    import { initializeGallery } from "@/lib/gallery";

    const destroyGallery = initializeGallery(document);
    window.addEventListener("pagehide", destroyGallery, { once: true });
  </script>
</Layout>

<style is:global>
  * {
    scrollbar-color: var(--color-button-muted) var(--color-fill);
  }

  @page {
    size: auto;
    margin: 0mm;
  }
  div.container {
    margin: auto;
    width: 100%;
  }

  @keyframes slide-enter {
    0% {
      transform: translateY(10px);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .slide-enter,
    .slide-enter-content > *:not(:has(.table-of-contents)) {
      --enter-stage: 0;
      --enter-step: 400ms;
      --enter-initial: 0ms;
      animation: slide-enter 1s both 1;
      animation-delay: calc(
        var(--enter-initial) + var(--enter-stage) * var(--enter-step)
      );
    }

    .slide-enter-content > *:nth-child(1) {
      --enter-stage: 1 !important;
    }
    .slide-enter-content > *:nth-child(2) {
      --enter-stage: 2 !important;
    }
    .slide-enter-content > *:nth-child(3) {
      --enter-stage: 3 !important;
    }
    .slide-enter-content > *:nth-child(4) {
      --enter-stage: 4 !important;
    }
    .slide-enter-content > *:nth-child(5) {
      --enter-stage: 5 !important;
    }
    .slide-enter-content > *:nth-child(6) {
      --enter-stage: 6 !important;
    }
  }
</style>
