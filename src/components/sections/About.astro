---
import Section from "../Section.astro";
import { getTranslations } from "@/i18n";
import type { Locale } from "@/types";

interface Props {
  summary: string[];
  locale: Locale;
}

const { summary, locale } = Astro.props;
const t = getTranslations(locale);
---

<Section id="about" title={t.sections.about} compact>
  <div class="space-y-2 font-sans opacity-80">
    {summary.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Section>
