---
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@/i18n";
import { type Locale, type Skill } from "@/types";

interface Props {
  skills: Skill[];
  locale: Locale;
}
const { skills, locale } = Astro.props;
const t = getTranslations(locale);
---

<Section title={t.sections.skills} id="skills">
  <ul
    class="[&>li>svg]:text-skin-hue inline-flex flex-wrap gap-4 font-mono [&>li]:text-sm"
  >
    {
      skills.map(({ name, icon, level }) => {
        return (
          <li
            class="border-skin-muted/60 bg-skin-button-muted/70 text-skin-base flex items-center gap-1 rounded-md border border-solid px-1 py-0.5 text-xs"
            title={level}
          >
            {icon && (
              <Icon name={icon} width={16} height={16} aria-hidden="true" />
            )}{" "}
            <span>{name}</span>
          </li>
        );
      })
    }
  </ul>
</Section>
