---
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getTranslations } from "@/i18n";
import { type Locale, type Project } from "@/types";

interface Props {
  projects: Project[];
  locale: Locale;
}
const { projects, locale } = Astro.props;
const t = getTranslations(locale);
---

<Section title={t.sections.projects} id="work">
  <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
    {
      projects.map(
        ({ url, description, highlights, name, isActive, github, image }) => {
          const isContainerImage = image && image?.position === "container";
          return (
            <article
              class:list={[
                "project-container grid-span-1 group bg-skin-button-muted/50 ring-skin-muted relative flex min-h-80 flex-col overflow-hidden rounded-md p-5 shadow-sm ring-1",
              ]}
            >
              <div
                class={`relative z-10 flex items-center justify-between space-x-[10px]`}
              >
                <div class="flex items-center gap-2">
                  <Icon name="mdi:folder-outline" class="size-4" />
                  <div class="flex items-center gap-[6px]">
                    {isActive ? (
                      <a
                        class="group hover:text-skin-hue flex items-center gap-[6px] text-lg decoration-dotted underline-offset-[5px] hover:underline"
                        href={url}
                        title={t.actions.visit(name)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {name}
                        <span class="text-skin-hue transition ease-linear group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                          <Icon
                            name="ri:arrow-up-line"
                            class="rotate-45"
                            aria-hidden="true"
                          />
                        </span>
                      </a>
                    ) : (
                      <span>{name}</span>
                    )}
                  </div>
                </div>

                {github && (
                  <a
                    href={github}
                    aria-label={t.actions.repository(name)}
                    title={t.actions.repository(name)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="opacity-75 transition duration-100 hover:scale-125 hover:opacity-100"
                  >
                    <Icon
                      name="mdi:github"
                      width={24}
                      height={24}
                      aria-hidden="true"
                    />
                  </a>
                )}
              </div>

              <p class={`text-skin-base relative z-10 py-3 text-sm`}>
                {description}
              </p>
              <ul class="text-skin-base relative z-10 mt-1 text-sm">
                {highlights.map((highlight) => {
                  return <li>{highlight}</li>;
                })}
              </ul>
              {isContainerImage && (
                <a
                  href={image.url}
                  data-src={image.url}
                  data-fancybox="projects"
                  aria-label={t.actions.screenshot(name)}
                >
                  <Image
                    src={image.url}
                    alt={`${name} project screenshot`}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    sizes="(min-width: 768px) 320px, calc(100vw - 4rem)"
                    class:list={["mt-3 h-auto max-w-full rounded-lg"]}
                  />
                </a>
              )}
            </article>
          );
        },
      )
    }
  </div>
</Section>
<style>
  @reference "../../globals.css";

  ul {
    @apply ml-4 list-disc space-y-1;
    li {
      @apply text-skin-base;
    }
  }
</style>
