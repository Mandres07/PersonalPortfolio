---
import { Image } from "astro:assets";
import Section from "../Section.astro";
import { getTranslations } from "@/i18n";
import { type ImageList, type Locale } from "@/types";

interface Props {
  images: ImageList;
  locale: Locale;
}
const { images, locale } = Astro.props;
const t = getTranslations(locale);
---

<Section title={t.sections.images} id="images">
  {images.intro && <p class="text-skin-muted ml-3 font-mono">{images.intro}</p>}
  <div
    class="grid grid-cols-1 gap-2 p-2 pt-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
  >
    {
      images.list.map(({ image, alt, desc }) => (
        <a
          href={image}
          data-fancybox="gallery"
          data-caption={desc}
          class="border-skin-hue/20 bg-skin-button-accent/20 block aspect-square overflow-hidden rounded-lg border"
          aria-label={desc}
        >
          <Image
            src={image}
            alt={alt}
            width={500}
            height={500}
            loading="lazy"
            sizes="(min-width: 1024px) 160px, (min-width: 640px) 33vw, calc(100vw - 4rem)"
            class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
          />
        </a>
      ))
    }
  </div>
</Section>
