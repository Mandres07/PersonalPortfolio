---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getTranslations } from "@/i18n";
import { type Basics, type Locale } from "@/types";

interface Props {
  basics: Basics;
  locale: Locale;
}

const { basics, locale } = Astro.props;
const { name, label, image, location, profiles, email, phone } = basics;
const { city, region, address } = location;
const t = getTranslations(locale);
---

<header>
  <div class="flex flex-col-reverse gap-6">
    <div class="info">
      <h1>{name}</h1>
      <p class="job-title">{label}</p>
      <address class="text-skin-muted mt-2 flex items-center gap-2 not-italic">
        <Icon name="mdi:world" width={20} height={20} aria-hidden="true" />
        {address}, {city}, {region}
      </address>
      <p class="print none text-skin-muted flex items-center gap-2">
        <Icon name="mdi:email" width={20} height={20} aria-hidden="true" />
        {email}
      </p>
      <ul id="social-icons">
        {
          email && (
            <li>
              <a
                href={`mailto:${email}`}
                title={t.actions.sendEmail}
                class="email-action"
              >
                <Icon
                  name="mdi:email"
                  width={20}
                  height={20}
                  aria-hidden="true"
                />
                {t.actions.emailMe}
              </a>
            </li>
          )
        }
        {
          phone && (
            <li>
              <a
                href={`https://wa.me/${phone}`}
                title={t.actions.sendMessage}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.actions.sendMessage}
              >
                <Icon
                  name="ri:whatsapp-fill"
                  width={20}
                  height={20}
                  aria-hidden="true"
                />
              </a>
            </li>
          )
        }
        {
          profiles.map(({ network, url, icon }) => {
            return (
              <li>
                <a
                  href={url}
                  title={t.actions.visitProfile(network)}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={t.actions.visitProfile(network)}
                >
                  <Icon name={icon} width={20} height={20} aria-hidden="true" />
                </a>
              </li>
            );
          })
        }
        <li>
          <button
            type="button"
            disabled
            data-command-palette-trigger
            class="footer-button group border-skin-button-accent text-skin-button-accent hover:bg-skin-button-accent hover:text-skin-inverted [&>span]:hover:text-skin-inverted flex h-8 w-8 cursor-pointer items-center justify-center rounded-md border border-solid bg-transparent transition-all duration-200 ease-linear max-sm:hidden"
            aria-label={t.actions.openPalette}
          >
            <Icon name="ri:command-fill" class="h-5 w-5" aria-hidden="true" />
          </button>
        </li>
      </ul>
    </div>
    <div class="flex items-end justify-start gap-2">
      <figure class="relative w-fit">
        <Image
          class="shadow-skin-hues object-cover object-center shadow-lg transition-all duration-200 ease-linear hover:scale-105"
          height={600}
          width={600}
          src={image}
          alt={name}
          loading="eager"
          fetchpriority="high"
          sizes="128px"
        />
        <div class="pointer-events-none absolute -inset-2">
          <div
            class="bg-skin-button-accent/50 absolute -inset-y-8 right-0 w-px [mask-image:linear-gradient(to_top,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
          >
          </div>
          <div
            class="bg-skin-button-accent/50 absolute -inset-y-8 left-0 w-px [mask-image:linear-gradient(to_top,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
          >
          </div>
          <div
            class="bg-skin-button-accent/50 absolute -inset-x-8 bottom-0 h-px [mask-image:linear-gradient(to_left,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
          >
          </div>
          <div
            class="bg-skin-button-accent/50 absolute -inset-x-8 top-0 h-px [mask-image:linear-gradient(to_left,transparent,white_4rem,white_calc(100%-4rem),transparent)]"
          >
          </div>
        </div>
      </figure>
    </div>
  </div>
</header>

<style>
  @reference "../../globals.css";

  .info {
    @apply flex flex-col gap-1 pr-8;
  }

  h1 {
    @apply text-4xl font-bold;
  }

  .job-title {
    @apply font-mono text-base font-bold text-balance;
  }

  img {
    @apply aspect-square w-32 rounded-2xl bg-cover;
  }

  span {
    @apply text-skin-button-accent flex items-center gap-1 text-xs;
  }

  #social-icons {
    @apply mt-3 flex flex-wrap gap-1.5 text-sm;
  }

  #social-icons a,
  #social-icons button {
    @apply border-skin-nav text-skin-nav hover:bg-skin-button-muted inline-flex size-11 items-center justify-center rounded-md border border-solid bg-transparent transition-colors duration-200 ease-linear;
  }

  #social-icons .email-action {
    @apply bg-skin-nav text-skin-fill hover:bg-skin-nav w-auto gap-2 px-3 font-semibold hover:opacity-90;
  }

  #social-icons [data-command-palette-trigger] {
    @apply hidden sm:inline-flex;
  }

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
    }

    .info {
      @apply pr-0 md:items-center md:justify-center;
    }

    figure {
      @apply flex md:items-center md:justify-center;
    }

    h1 {
      @apply text-3xl;
    }

    .job-title {
      text-wrap: balance;
    }

    figure {
      @apply md:mx-auto;
    }
  }
</style>
