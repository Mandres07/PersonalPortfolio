---
import Section from "../Section.astro";
import { getTranslations } from "@/i18n";
import { getYearFromIsoDate } from "@/lib/date";
import { type EducationEntry, type Certificate, type Locale } from "@/types";

interface Props {
  certificates: Certificate[];
  education: EducationEntry[];
  locale: Locale;
}
const { certificates, education, locale } = Astro.props;
const t = getTranslations(locale);
---

<Section title={t.sections.education} id="education">
  <ul class="space-y-4 pb-3">
    {
      education.map(({ institution, startDate, endDate, area, url }) => {
        const startYear = getYearFromIsoDate(startDate);
        const endYear =
          endDate != null ? getYearFromIsoDate(endDate) : t.dates.present;
        const years = `${startYear} - ${endYear}`;

        return (
          <li class="flex items-baseline">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mr-2 hidden h-5 w-5 self-start md:inline-block"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
              <path d="M22 10v6" />
              <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
            </svg>
            <div class="relative w-full items-baseline justify-between gap-2">
              <h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium">
                {url ? (
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group text-skin-base hover:text-skin-hue flex items-center gap-[6px] decoration-dotted underline-offset-[5px] hover:underline"
                    href={url}
                  >
                    {institution}
                  </a>
                ) : (
                  <span>{institution}</span>
                )}
              </h3>
              <div class="text-skin-muted text-sm">{area}</div>
              <time
                datetime={startDate}
                class="text-skin-muted top-0 right-0 text-xs md:absolute md:block"
              >
                {years}
              </time>
            </div>
          </li>
        );
      })
    }
  </ul>

  {
    certificates.length > 0 && (
      <>
        <h3 class="font-mono text-lg font-semibold">
          {t.sections.certificates}
        </h3>
        <ul class="space-y-4 py-3">
          {certificates.map(({ name, date, issuer, url }) => {
            const certificateYear = getYearFromIsoDate(date);
            return (
              <li class="flex items-baseline">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mr-2 hidden h-5 w-5 self-start md:inline-block"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M15 12h-5" />
                  <path d="M15 8h-5" />
                  <path d="M19 17V5a2 2 0 0 0-2-2H4" />
                  <path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3" />
                </svg>
                <div class="relative w-full items-baseline justify-between gap-2">
                  <h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium">
                    {url ? (
                      <a
                        class="group text-skin-base hover:text-skin-hue flex items-center gap-[6px] decoration-dotted underline-offset-[5px] hover:underline"
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {name}
                      </a>
                    ) : (
                      <span>{name}</span>
                    )}
                  </h3>
                  <div class="text-skin-muted text-sm">{issuer}</div>
                  <time
                    datetime={date}
                    class="text-skin-muted top-0 right-0 text-xs md:absolute md:block"
                  >
                    {certificateYear}
                  </time>
                </div>
              </li>
            );
          })}
        </ul>
      </>
    )
  }
</Section>
