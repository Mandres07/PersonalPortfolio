---
import { getTranslations } from "@/i18n";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
---

<footer
  id="tail"
  class="slide-enter bg-skin-button-accent/15 flex w-full justify-center px-5 py-3 text-center font-mono md:col-span-6 md:pt-1 md:pb-14"
>
  <div class="flex items-center space-x-0 text-xs opacity-80">
    <div class="gap-1 text-center no-underline">
      <p class="mt-2 text-center">
        {t.footer.remote}
      </p>
      <p class="mt-2 text-center">
        © {year} - {t.footer.copyright}
      </p>
    </div>
  </div>
</footer>
