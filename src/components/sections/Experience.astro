---
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@/i18n";
import { getYearFromIsoDate } from "@/lib/date";
import type { Locale, Work } from "@/types";

interface Props {
  work: Work[];
  locale: Locale;
}

const { work, locale } = Astro.props;
const t = getTranslations(locale);
---

<Section title={t.sections.experience} id="experience">
  <ol class="flex flex-col">
    {
      work.map(
        ({
          id,
          name,
          startDate,
          endDate,
          position,
          summary,
          responsibilities,
          achievements,
          url,
          skills,
          location,
          location_type: locationType,
        }) => {
          const startYear = getYearFromIsoDate(startDate);
          const endYear = endDate
            ? getYearFromIsoDate(endDate)
            : t.experience.present;
          const summaryItems = Array.isArray(summary) ? summary : [summary];
          const hasDetails =
            responsibilities.length > 0 || achievements.length > 0;

          return (
            <li class="relative" id={`experience-${id}`}>
              <article class="group relative grid pb-1 sm:grid-cols-10 sm:gap-8 md:gap-6">
                <p class="relative mt-1 font-mono text-xs font-semibold sm:col-span-2 lg:mx-1">
                  <time datetime={startDate}>{startYear}</time> –{" "}
                  {endDate ? (
                    <time datetime={endDate}>{endYear}</time>
                  ) : (
                    <span>{endYear}</span>
                  )}
                </p>

                <div class="before:bg-skin-muted relative flex flex-col pb-6 before:absolute before:mt-2 before:-ml-6 before:h-full before:w-px sm:col-span-8">
                  <span
                    aria-hidden="true"
                    class="bg-skin-muted ring-skin-fill absolute mt-2 h-2 w-2 -translate-x-[1.71rem] rounded-full ring"
                  />
                  <h3 class="text-lg leading-tight">
                    <span>{position} @ </span>
                    {url ? (
                      <a
                        class="group/link text-skin-hue inline-flex items-center hover:underline"
                        href={url}
                        title={t.actions.visit(name)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {name}
                        <Icon
                          name="ri:arrow-up-line"
                          class="ml-1 h-4 w-4 rotate-45 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 motion-reduce:transition-none"
                          aria-hidden="true"
                        />
                      </a>
                    ) : (
                      <span>{name}</span>
                    )}
                  </h3>

                  {(location || locationType) && (
                    <p class="text-skin-muted text-xs">
                      {[location, locationType].filter(Boolean).join(" — ")}
                    </p>
                  )}

                  <div class="mt-4 flex flex-col gap-4 text-sm">
                    {summaryItems.length > 0 && (
                      <div class="flex flex-col gap-1">
                        <h4>{t.experience.summary}</h4>
                        <ul class="text-skin-muted ml-4 flex list-disc flex-col gap-2">
                          {summaryItems.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {hasDetails && (
                      <details class="group/details border-skin-muted/60 rounded-md border p-3">
                        <summary class="text-skin-hue marker:text-skin-hue cursor-pointer font-medium">
                          {t.actions.details}
                        </summary>
                        <div class="mt-4 flex flex-col gap-4">
                          {responsibilities.length > 0 && (
                            <div class="flex flex-col gap-1">
                              <h4>{t.experience.responsibilities}</h4>
                              <ul class="text-skin-muted ml-4 flex list-disc flex-col gap-2">
                                {responsibilities.map((item) => (
                                  <li>{item}</li>
                                ))}
                              </ul>
                            </div>
                          )}
                          {achievements.length > 0 && (
                            <div class="flex flex-col gap-1">
                              <h4>{t.experience.achievements}</h4>
                              <ul class="text-skin-muted ml-4 flex list-disc flex-col gap-2">
                                {achievements.map((item) => (
                                  <li>{item}</li>
                                ))}
                              </ul>
                            </div>
                          )}
                        </div>
                      </details>
                    )}

                    {Object.keys(skills).length > 0 && (
                      <ul
                        class="flex flex-wrap gap-2 font-mono"
                        aria-label={t.experience.technologies}
                      >
                        {Object.entries(skills).map(([label, icon]) => (
                          <li class="border-skin-muted/60 bg-skin-button-muted/70 text-skin-base flex items-center gap-1 rounded-md border border-solid px-2 py-0.5 text-xs backdrop-blur-sm">
                            {icon && (
                              <Icon
                                name={icon}
                                width={16}
                                height={16}
                                aria-hidden="true"
                              />
                            )}
                            <span>{label}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </article>
            </li>
          );
        },
      )
    }
  </ol>
</Section>

<style>
  @reference "../../globals.css";

  li::marker {
    @apply text-skin-hue;
  }
</style>
