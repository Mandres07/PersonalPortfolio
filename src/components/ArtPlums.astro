---
// Decorative generative artwork adapted from Antfu's plum animation.
---

<div
  class="art-plums pointer-events-none fixed inset-0"
  aria-hidden="true"
  style="mask-image: radial-gradient(circle, transparent, black); -webkit-mask-image: radial-gradient(circle, transparent, black);"
>
  <canvas id="artPlumCanvas" width="400" height="400"></canvas>
</div>

<script>
  const canvas = document.getElementById(
    "artPlumCanvas",
  ) as HTMLCanvasElement | null;

  if (canvas) {
    const context = canvas.getContext("2d");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const abortController = new AbortController();
    const { signal } = abortController;
    const branchAngle = Math.PI / 12;
    const minimumBranch = 30;
    const branchLength = 6;
    const size = { width: window.innerWidth, height: window.innerHeight };
    let animationFrame: number | null = null;
    let resizeTimer: number | null = null;
    let steps: Array<() => void> = [];

    const randomMiddle = () => Math.random() * 0.6 + 0.2;

    const resizeCanvas = () => {
      if (!context) return;
      const dpr = window.devicePixelRatio || 1;
      size.width = window.innerWidth;
      size.height = window.innerHeight;
      canvas.style.width = `${size.width}px`;
      canvas.style.height = `${size.height}px`;
      canvas.width = Math.round(size.width * dpr);
      canvas.height = Math.round(size.height * dpr);
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    interface Counter {
      value: number;
    }

    const step = (
      x: number,
      y: number,
      radians: number,
      counter: Counter = { value: 0 },
    ): void => {
      if (!context) return;
      const length = Math.random() * branchLength;
      counter.value += 1;
      const nextX = x + length * Math.cos(radians);
      const nextY = y + length * Math.sin(radians);

      context.beginPath();
      context.moveTo(x, y);
      context.lineTo(nextX, nextY);
      context.stroke();

      if (
        nextX < -100 ||
        nextX > size.width + 100 ||
        nextY < -100 ||
        nextY > size.height + 100
      ) {
        return;
      }

      // Keep one shared counter per originating branch. This preserves the
      // original sparse plum shape and prevents every child from spawning a
      // dense independent tree.
      const branchRate = counter.value <= minimumBranch ? 0.8 : 0.5;
      if (Math.random() < branchRate) {
        steps.push(() =>
          step(nextX, nextY, radians + Math.random() * branchAngle, counter),
        );
      }
      if (Math.random() < branchRate) {
        steps.push(() =>
          step(nextX, nextY, radians - Math.random() * branchAngle, counter),
        );
      }
    };

    const frame = () => {
      const currentSteps = steps;
      steps = [];

      currentSteps.forEach((currentStep) => {
        if (Math.random() < 0.5) steps.push(currentStep);
        else currentStep();
      });

      animationFrame = steps.length > 0 ? requestAnimationFrame(frame) : null;
    };

    const stop = () => {
      if (animationFrame !== null) cancelAnimationFrame(animationFrame);
      animationFrame = null;
      steps = [];
    };

    const start = () => {
      stop();
      resizeCanvas();
      if (!context) return;
      context.clearRect(0, 0, size.width, size.height);
      if (reducedMotion.matches || document.hidden) return;

      context.lineWidth = 1;
      context.strokeStyle = "#88888825";
      steps = [
        () => step(randomMiddle() * size.width, -5, Math.PI / 2),
        () => step(randomMiddle() * size.width, size.height + 5, -Math.PI / 2),
        () => step(-5, randomMiddle() * size.height, 0),
        () => step(size.width + 5, randomMiddle() * size.height, Math.PI),
      ];
      if (size.width < 500) steps = steps.slice(0, 2);
      animationFrame = requestAnimationFrame(frame);
    };

    window.addEventListener(
      "resize",
      () => {
        if (resizeTimer !== null) window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(start, 150);
      },
      { signal },
    );
    document.addEventListener("visibilitychange", start, { signal });
    reducedMotion.addEventListener("change", start, { signal });
    window.addEventListener(
      "pagehide",
      () => {
        stop();
        abortController.abort();
      },
      { once: true },
    );

    start();
  }
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    .art-plums {
      display: none;
    }
  }
</style>
